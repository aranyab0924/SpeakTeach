# Frontend (Vite). Copy into frontend/.env.local — never commit real values.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (optional). Comma-separated browser origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173,https://YOUR-APP.vercel.app

# FastAPI does not talk to Supabase. Do not add a service-role / secret key.
# That key bypasses RLS and must never be placed in the browser.
